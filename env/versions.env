KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.1
ARGOCD_VERSION=v3.5.7
KUBESEAL_VERSION=0.41.2
ROLLOUTS_VERSION=v1.10.1

# Cluster
KIND_NODE_IMAGE=kindest/node:v1.37.0
GITEA_IMAGE=gitea/gitea:28.3

# Helm charts
ARGOCD_CHART_VERSION=10.11.7
TRAEFIK_CHART_VERSION=42.3.0
SEALED_SECRETS_CHART_VERSION=2.22.0
ROLLOUTS_CHART_VERSION=2.43.8
IMAGE_UPDATER_CHART_VERSION=1.4.0
PODINFO_CHART_VERSION=6.17.0

# Gitea account used in all labs (training only!)
GITEA_USER=student
GITEA_PASSWORD=Gitea-Lab-2026!
